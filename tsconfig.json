{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,

        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],

        "types": [
            "vite/client"
        ]
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue",
        "vite.config.ts"
    ]
}